generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum HouseholdRole {
  ADMIN
  MEMBER
}

enum AccountType {
  CHECKING
  SAVINGS
  PAYMENT
  CASH
  INVESTMENT
  OTHER
}

enum HolderKind {
  MEMBER
  HOUSEHOLD
}

enum CategoryKind {
  INCOME
  EXPENSE
}

enum TxType {
  INCOME
  EXPENSE
  TRANSFER
  ADJUSTMENT
  CONTRIBUTION
  WITHDRAWAL
  YIELD
}

enum TxStatus {
  PENDING
  CLEARED
  SCHEDULED
  CANCELLED
}

enum TxOrigin {
  MANUAL
  IMPORT
  SYSTEM
  CARD
  TRANSFER
}

enum InvoiceStatus {
  OPEN
  CLOSED
  PAID
  PARTIAL
}

enum ImportFormat {
  CSV
  OFX
  PDF
}

enum ImportBatchStatus {
  PREVIEW
  CONFIRMED
  REVERTED
  FAILED
}

enum ImportRowStatus {
  PENDING
  READY
  DUPLICATE
  SKIPPED
  IMPORTED
  NEEDS_REVIEW
}

enum ClassificationState {
  AUTO
  SUGGESTED
  CONFIRMED
  UNKNOWN
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  preferences   Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions               Session[]
  accounts               Account[]
  memberships            HouseholdMember[]
  invitationsCreated     HouseholdInvitation[]
  authShareLinks         AuthShareLink[]
  financialAccountsHeld  FinancialAccount[]      @relation("AccountHolder")
  creditCardsHeld        CreditCard[]            @relation("CardHolder")
  transactionsHeld       Transaction[]           @relation("TxHolder")
  transactionsCreated    Transaction[]           @relation("TxCreatedBy")
  transactionsUpdated    Transaction[]           @relation("TxUpdatedBy")
  importBatchesCreated   ImportBatch[]           @relation("ImportBatchCreator")

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Household {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members           HouseholdMember[]
  invitations       HouseholdInvitation[]
  financialAccounts FinancialAccount[]
  categories        Category[]
  transactions      Transaction[]
  transferGroups    TransferGroup[]
  creditCards         CreditCard[]
  invoices            CreditCardInvoice[]
  recurringRules      RecurringTransaction[]
  importBatches       ImportBatch[]
  importMappings      ImportMapping[]
  categorizationRules CategorizationRule[]

  @@map("household")
}

model HouseholdMember {
  id          String        @id @default(cuid())
  householdId String
  userId      String
  role        HouseholdRole @default(MEMBER)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  household Household @relation(fields: [householdId], references: [id], onDelete: Restrict)
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, householdId])
  @@index([householdId])
  @@index([userId])
  @@map("household_member")
}

model HouseholdInvitation {
  id          String        @id @default(cuid())
  householdId String
  email       String?
  role        HouseholdRole @default(MEMBER)
  token       String
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdById String
  createdAt   DateTime      @default(now())

  household Household @relation(fields: [householdId], references: [id], onDelete: Restrict)
  createdBy User      @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([token])
  @@index([householdId])
  @@index([expiresAt])
  @@map("household_invitation")
}

model AuthShareLink {
  id        String   @id @default(cuid())
  type      String
  email     String
  url       String
  expiresAt DateTime
  createdAt DateTime @default(now())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email, type, createdAt])
  @@map("auth_share_link")
}

model FinancialAccount {
  id                 String      @id @default(cuid())
  householdId        String
  name               String
  institution        String?
  type               AccountType @default(CHECKING)
  holderKind         HolderKind  @default(HOUSEHOLD)
  holderUserId       String?
  initialBalance     Decimal     @default(0) @db.Decimal(18, 2)
  initialBalanceDate DateTime    @db.Date
  currency           String      @default("BRL")
  isActive           Boolean     @default(true)
  notes              String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  deletedAt          DateTime?

  household       Household        @relation(fields: [householdId], references: [id], onDelete: Restrict)
  holder          User?            @relation("AccountHolder", fields: [holderUserId], references: [id], onDelete: SetNull)
  transactions    Transaction[]
  transfersOut    TransferGroup[]  @relation("TransferFrom")
  transfersIn     TransferGroup[]  @relation("TransferTo")
  importBatches   ImportBatch[]
  importMappings  ImportMapping[]
  statedBalance   Decimal?         @db.Decimal(18, 2)
  statedBalanceAt DateTime?
  lastReconciledAt DateTime?

  @@index([householdId, isActive])
  @@index([holderUserId])
  @@map("financial_account")
}

model Category {
  id          String       @id @default(cuid())
  householdId String
  parentId    String?
  kind        CategoryKind
  name        String
  isSystem    Boolean      @default(false)
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  household    Household    @relation(fields: [householdId], references: [id], onDelete: Restrict)
  parent       Category?    @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children     Category[]   @relation("CategoryTree")
  transactions Transaction[]
  rules        CategorizationRule[]

  @@unique([householdId, kind, name, parentId])
  @@index([householdId, kind])
  @@map("category")
}

model TransferGroup {
  id              String   @id @default(cuid())
  householdId     String
  fromAccountId   String
  toAccountId     String
  amount          Decimal  @db.Decimal(18, 2)
  movementDate    DateTime @db.Date
  description     String?
  createdAt       DateTime @default(now())

  household   Household        @relation(fields: [householdId], references: [id], onDelete: Restrict)
  fromAccount FinancialAccount @relation("TransferFrom", fields: [fromAccountId], references: [id], onDelete: Restrict)
  toAccount   FinancialAccount @relation("TransferTo", fields: [toAccountId], references: [id], onDelete: Restrict)
  legs        Transaction[]

  @@index([householdId])
  @@map("transfer_group")
}

model RecurringTransaction {
  id             String     @id @default(cuid())
  householdId    String
  type           TxType
  amount         Decimal    @db.Decimal(18, 2)
  description    String
  categoryId     String?
  accountId      String?
  creditCardId   String?
  holderKind     HolderKind @default(HOUSEHOLD)
  holderUserId   String?
  dayOfMonth     Int
  startDate      DateTime   @db.Date
  endDate        DateTime?  @db.Date
  isActive       Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  household    Household     @relation(fields: [householdId], references: [id], onDelete: Restrict)
  transactions Transaction[]

  @@index([householdId, isActive])
  @@map("recurring_transaction")
}

model CreditCard {
  id           String   @id @default(cuid())
  householdId  String
  institution  String
  name         String
  holderUserId String?
  creditLimit  Decimal  @default(0) @db.Decimal(18, 2)
  closingDay   Int
  dueDay       Int
  isActive     Boolean  @default(true)
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  household    Household           @relation(fields: [householdId], references: [id], onDelete: Restrict)
  holder       User?               @relation("CardHolder", fields: [holderUserId], references: [id], onDelete: SetNull)
  invoices     CreditCardInvoice[]
  transactions Transaction[]

  @@index([householdId, isActive])
  @@map("credit_card")
}

model CreditCardInvoice {
  id                   String        @id @default(cuid())
  householdId          String
  creditCardId         String
  referenceMonth       DateTime      @db.Date
  closingDate          DateTime      @db.Date
  dueDate              DateTime      @db.Date
  status               InvoiceStatus @default(OPEN)
  paidAt               DateTime?
  paymentTransactionId String?       @unique
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  household          Household   @relation(fields: [householdId], references: [id], onDelete: Restrict)
  creditCard         CreditCard  @relation(fields: [creditCardId], references: [id], onDelete: Restrict)
  paymentTransaction Transaction? @relation("InvoicePayment", fields: [paymentTransactionId], references: [id], onDelete: SetNull)
  purchases          Transaction[] @relation("InvoicePurchases")

  @@unique([creditCardId, referenceMonth])
  @@index([householdId, status])
  @@map("credit_card_invoice")
}

model Transaction {
  id                 String    @id @default(cuid())
  householdId        String
  type               TxType
  amount             Decimal   @db.Decimal(18, 2)
  description        String
  categoryId         String?
  accountId          String?
  creditCardId       String?
  invoiceId          String?
  holderKind         HolderKind @default(HOUSEHOLD)
  holderUserId       String?
  movementDate       DateTime  @db.Date
  competenceDate     DateTime? @db.Date
  dueDate            DateTime? @db.Date
  status             TxStatus  @default(CLEARED)
  origin             TxOrigin  @default(MANUAL)
  notes              String?
  transferGroupId    String?
  installmentGroupId String?
  installmentNumber  Int?
  installmentTotal   Int?
  recurringId        String?
  fingerprint        String?
  bankTxnId          String?
  importBatchId      String?
  deletedAt          DateTime?
  createdById        String?
  updatedById        String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  household     Household            @relation(fields: [householdId], references: [id], onDelete: Restrict)
  category      Category?            @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  account       FinancialAccount?    @relation(fields: [accountId], references: [id], onDelete: Restrict)
  creditCard    CreditCard?          @relation(fields: [creditCardId], references: [id], onDelete: Restrict)
  invoice       CreditCardInvoice?   @relation("InvoicePurchases", fields: [invoiceId], references: [id], onDelete: SetNull)
  transferGroup TransferGroup?       @relation(fields: [transferGroupId], references: [id], onDelete: SetNull)
  recurring     RecurringTransaction? @relation(fields: [recurringId], references: [id], onDelete: SetNull)
  holder        User?                @relation("TxHolder", fields: [holderUserId], references: [id], onDelete: SetNull)
  createdBy     User?                @relation("TxCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy     User?                @relation("TxUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  paidInvoice   CreditCardInvoice?   @relation("InvoicePayment")
  importBatch   ImportBatch?         @relation(fields: [importBatchId], references: [id], onDelete: SetNull)

  @@index([householdId, movementDate])
  @@index([householdId, type, status])
  @@index([accountId, movementDate])
  @@index([creditCardId])
  @@index([invoiceId])
  @@index([transferGroupId])
  @@index([installmentGroupId])
  @@index([fingerprint])
  @@index([bankTxnId])
  @@index([importBatchId])
  @@index([deletedAt])
  @@map("transaction")
}

model ImportBatch {
  id              String            @id @default(cuid())
  householdId     String
  accountId       String
  format          ImportFormat
  fileName        String
  fileHash        String
  status          ImportBatchStatus @default(PREVIEW)
  rowCount        Int               @default(0)
  importedCount   Int               @default(0)
  duplicateCount  Int               @default(0)
  rejectedCount   Int               @default(0)
  mappingId       String?
  warningMessage  String?
  createdById     String
  createdAt       DateTime          @default(now())
  confirmedAt     DateTime?
  revertedAt      DateTime?

  household    Household         @relation(fields: [householdId], references: [id], onDelete: Restrict)
  account      FinancialAccount  @relation(fields: [accountId], references: [id], onDelete: Restrict)
  mapping      ImportMapping?    @relation(fields: [mappingId], references: [id], onDelete: SetNull)
  createdBy    User              @relation("ImportBatchCreator", fields: [createdById], references: [id], onDelete: Restrict)
  rows         ImportRow[]
  transactions Transaction[]

  @@index([householdId, createdAt])
  @@index([accountId, fileHash])
  @@index([status])
  @@map("import_batch")
}

model ImportRow {
  id                   String              @id @default(cuid())
  batchId              String
  lineNumber           Int
  rawJson              Json
  movementDate         DateTime?           @db.Date
  description          String?
  amount               Decimal?            @db.Decimal(18, 2)
  signedAmount         Decimal?            @db.Decimal(18, 2)
  bankTxnId            String?
  balanceAfter         Decimal?            @db.Decimal(18, 2)
  suggestedType        TxType?
  suggestedCategoryId  String?
  classificationState  ClassificationState @default(UNKNOWN)
  fingerprint          String?
  duplicateOfTxId      String?
  status               ImportRowStatus     @default(PENDING)
  userType             TxType?
  userCategoryId       String?
  userDescription      String?
  include              Boolean             @default(true)
  reviewNote           String?

  batch ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId, status])
  @@index([fingerprint])
  @@index([bankTxnId])
  @@map("import_row")
}

model ImportMapping {
  id          String   @id @default(cuid())
  householdId String
  accountId   String?
  name        String
  delimiter   String   @default(";")
  encoding    String   @default("utf-8")
  hasHeader   Boolean  @default(true)
  columnMap   Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  household Household         @relation(fields: [householdId], references: [id], onDelete: Restrict)
  account   FinancialAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  batches   ImportBatch[]

  @@index([householdId])
  @@map("import_mapping")
}

model CategorizationRule {
  id          String   @id @default(cuid())
  householdId String
  pattern     String
  categoryId  String
  txType      TxType?
  priority    Int      @default(100)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  household Household @relation(fields: [householdId], references: [id], onDelete: Restrict)
  category  Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([householdId, isActive, priority])
  @@map("categorization_rule")
}
