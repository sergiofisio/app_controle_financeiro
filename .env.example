# Runtime (Next.js / Prisma Client): Transaction pooler Supabase :6543
# Ex.: postgresql://postgres.[REF]:[SENHA]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=

# Migrations / Prisma CLI: Session pooler :5432 (recomendado em IPv4-only) ou Direct
# Ex.: postgresql://postgres.[REF]:[SENHA]@aws-0-[REGION].pooler.supabase.com:5432/postgres
DIRECT_URL=

# Better Auth — gere com: openssl rand -base64 32
BETTER_AUTH_SECRET=

# URL pública da aplicação
BETTER_AUTH_URL=http://localhost:3000
